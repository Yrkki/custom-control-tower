AWSTemplateFormatVersion: "2010-09-09"
Description: S3 Lifecycle rules for Control Tower Log Archive buckets - Single File Solution

Parameters:
  LogBucketName:
    Type: String
    Default: "aws-controltower-logs-640693977485-eu-west-1"
    Description: Main Control Tower logs bucket
  AccessLogBucketName:
    Type: String
    Default: "aws-controltower-s3-access-logs-640693977485-eu-west-1"
    Description: Control Tower S3 access logs bucket
  ExpirationInDays:
    Type: Number
    Default: 365
    Description: Expiration in days
  NoncurrentVersionExpirationInDays:
    Type: Number
    Default: 1
    Description: Noncurrent version expiration in days
  AbortIncompleteMultipartUploadDays:
    Type: Number
    Default: 7
    Description: Abort incomplete multipart upload days

  # NATIVE REUSABLE ANCHOR BLOCK: allows !Ref and is completely ignored by CloudFormation validation loops
  # DYNAMIC INTEGRATION HOOK
  # This receives the [custom:template_bucket] token injected dynamically by CfCT
  RulesTemplateURL:
    Type: String
    Default: "https://[custom:template_bucket]/s3-lifecycle-rules.template"
    Description: The rules subtemplate location in the internal S3 staging bucket where CfCT hosts our template files

Resources:
  LogBucketLifecycle:
    Type: AWS::CloudFormation::Stack
    Properties:
      TemplateURL: !Ref RulesTemplateURL
      Parameters:
        BucketName: !Ref LogBucketName
        ExpirationInDays: !Ref ExpirationInDays
        NoncurrentVersionExpirationInDays: !Ref NoncurrentVersionExpirationInDays
        AbortIncompleteMultipartUploadDays: !Ref AbortIncompleteMultipartUploadDays

  AccessLogBucketLifecycle:
    Type: AWS::CloudFormation::Stack
    Properties:
      TemplateURL: !Ref RulesTemplateURL
      Parameters:
        BucketName: !Ref AccessLogBucketName
        ExpirationInDays: !Ref ExpirationInDays
        NoncurrentVersionExpirationInDays: !Ref NoncurrentVersionExpirationInDays
        AbortIncompleteMultipartUploadDays: !Ref AbortIncompleteMultipartUploadDays
