AWSTemplateFormatVersion: "2010-09-09"
Description: S3 Lifecycle rules for Control Tower Log Archive buckets - Single File Solution

Parameters:
  TargetBucketNames:
    Type: CommaDelimitedList
    Default: "aws-controltower-logs-640693977485-eu-west-1,aws-controltower-s3-access-logs-640693977485-eu-west-1"
    Description: Comma-separated list of target S3 bucket names
  ExpirationInDays:
    Type: Number
    Default: 365
    Description: Expiration in days
  NoncurrentVersionExpirationInDays:
    Type: Number
    Default: 1
    Description: Noncurrent version expiration in days
  AbortIncompleteMultipartUploadDays:
    Type: Number
    Default: 7
    Description: Abort incomplete multipart upload days

Resources:
  "Fn::ForEach::ApplyBucketLifecycle":
    - BucketName
    - !Ref TargetBucketNames
    - "$BucketLifecycle&{BucketName}":
        Type: AWS::S3::Bucket
        DeletionPolicy: Retain
        UpdateReplacePolicy: Retain
        Properties:
          BucketName: !Ref BucketName
          LifecycleConfiguration:
            Rules:
              - Id: retention-period
                Status: Enabled
                Filter: {}
                Expiration:
                  Days: !Ref ExpirationInDays
                NoncurrentVersionExpiration:
                  NoncurrentDays: !Ref NoncurrentVersionExpirationInDays
              - Id: abort-incomplete-multipart
                Status: Enabled
                Filter: {}
                AbortIncompleteMultipartUpload:
                  DaysAfterInitiation: !Ref AbortIncompleteMultipartUploadDays
              - Id: delete-markers-cleanup
                Status: Enabled
                Filter: {}
                Expiration:
                  ExpiredObjectDeleteMarker: true
